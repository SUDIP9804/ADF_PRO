{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfsudipdev"
		},
		"LS_DATALAKE_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_DATALAKE'"
		},
		"LS_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_DB'"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://keyvaultsudipdevproject.vault.azure.net/"
		},
		"LS_ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagesudipdev.dfs.core.windows.net/"
		},
		"LS_DATALAKE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagesudipdev.dfs.core.windows.net/"
		},
		"LS_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "caresync-server-sudip.database.windows.net"
		},
		"LS_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"LS_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "databeli"
		},
		"LS_HTTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com/"
		},
		"LS_RESTAPI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfsudipdev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_DATALAKE_accountKey": {
						"value": "[parameters('LS_DATALAKE_accountKey')]"
					},
					"LS_DB_password": {
						"value": "[parameters('LS_DB_password')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_properties_typeProperties_url')]"
					},
					"LS_DATALAKE_properties_typeProperties_url": {
						"value": "[parameters('LS_DATALAKE_properties_typeProperties_url')]"
					},
					"LS_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_DB_properties_typeProperties_server')]"
					},
					"LS_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_DB_properties_typeProperties_database')]"
					},
					"LS_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_DB_properties_typeProperties_userName')]"
					},
					"LS_HTTP_properties_typeProperties_url": {
						"value": "[parameters('LS_HTTP_properties_typeProperties_url')]"
					},
					"LS_RESTAPI_properties_typeProperties_url": {
						"value": "[parameters('LS_RESTAPI_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adfsudipdev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adfsudipdev_ArmTemplate_0')]"
			]
		}
	]
}